# 배포 빌드 기준 예시. EXPO_PUBLIC_* 값은 빌드할 때 앱에 들어가므로 배포용 앱은 이 값으로 빌드합니다.
# 앱에는 비밀값을 넣지 않습니다(README 5장). 공개돼도 되는 값만 EXPO_PUBLIC_ 으로 둡니다.
# https://api.example.com 은 자리 표시 주소입니다. 실제 API 서버 주소로 바꿉니다.
# 로컬에서는 각 줄 아래 "로컬:" 값을 씁니다. 실제 기기는 localhost 대신 PC의 IP, Android 에뮬레이터는 10.0.2.2.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# 로컬: EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# 서버 없이 개발할 때만 true로 둡니다(기기에 저장). 배포 빌드는 false입니다.
EXPO_PUBLIC_USE_LOCAL_DATA=false
# Socket.IO 게이트웨이 (비우면 API 주소에서 /api/v1을 뺀 주소)
EXPO_PUBLIC_SOCKET_URL=
# 간편 로그인 버튼. 서버의 간편 로그인 주소(/auth/social/:provider/start)가 준비되지 않았으면 false로 둡니다.
EXPO_PUBLIC_SOCIAL_LOGIN=true
# 로컬: EXPO_PUBLIC_SOCIAL_LOGIN=false
