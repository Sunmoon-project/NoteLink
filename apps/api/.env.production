# 배포(Azure App Service) 기준 예시. 실제 값은 App Service의 환경 변수(앱 설정)에 넣고,
# 로컬에서는 복사해서 .env로 쓰되 각 줄 아래 "로컬:" 값으로 바꿉니다. .env는 커밋하지 않습니다.
# https://api.example.com 은 자리 표시 주소입니다. 실제 배포 주소로 모두 바꿉니다.

# MongoDB Atlas 접속 문자열(Atlas > Connect > Drivers). 끝의 /notelink가 DB 이름이고, AI 서버의 MONGODB_DB와 같아야 합니다.
MONGODB_URI=mongodb+srv://<사용자>:<비밀번호>@<클러스터>.mongodb.net/notelink?retryWrites=true&w=majority
# 로컬: MONGODB_URI=mongodb://localhost:27017/notelink
# App Service는 PORT를 정해 주므로 배포에서는 넣지 않아도 됩니다.
PORT=3000

# 인증(JWT) — 아래 값은 자리 표시입니다. 배포에서는 반드시 새로 만든 값으로 바꿉니다(로컬 개발 값과 달라야 함).
# 시크릿은 서로 다른 32자 이상, 수명은 숫자 + 단위(s m h d w y, 최소 1s)로 씁니다. 예: 15m, 14d
# 시크릿 만들기(access · refresh 각각 따로 한 번씩 실행): openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48-access
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# 구글 로그인 — 구글 콘솔 > 웹 애플리케이션 OAuth 클라이언트에서 발급한 값으로 바꿉니다. 시크릿은 커밋하지 않습니다.
# 아직 키가 없으면 아래 예시 값 그대로 두어도 서버는 시작되지만 구글 로그인은 동작하지 않습니다.
# GOOGLE_REDIRECT_URI는 구글 콘솔의 "승인된 리디렉션 URI"와 글자까지 같아야 합니다(https 주소, localhost만 http 허용).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/social/google/callback
# 로컬: GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/google/callback

# 카카오 로그인 — 카카오 개발자 콘솔 > 앱 > 플랫폼 키 > REST API 키에서 발급한 값으로 바꿉니다. 시크릿은 커밋하지 않습니다.
# 클라이언트 시크릿은 같은 화면에서 확인합니다(REST API 키는 기본으로 켜져 있어 필수입니다).
# KAKAO_REDIRECT_URI는 같은 화면의 "리다이렉트 URI"와 글자까지 같아야 합니다(https 주소, localhost만 http 허용).
KAKAO_REST_API_KEY=your-rest-api-key
KAKAO_CLIENT_SECRET=your-client-secret
KAKAO_REDIRECT_URI=https://api.example.com/api/v1/auth/social/kakao/callback
# 로컬: KAKAO_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/kakao/callback

# 네이버 로그인 — 네이버 개발자센터 > 애플리케이션 > 내 애플리케이션에서 발급한 값으로 바꿉니다. 시크릿은 커밋하지 않습니다.
# NAVER_REDIRECT_URI는 같은 화면의 "Callback URL"과 글자까지 같아야 합니다(https 주소, localhost만 http 허용).
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret
NAVER_REDIRECT_URI=https://api.example.com/api/v1/auth/social/naver/callback
# 로컬: NAVER_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/naver/callback

# 가입 인증번호 메일 — MAIL_TRANSPORT로 발송 수단을 고릅니다. 비워 두면 메일을 보내지 않아 이메일 가입이 503(MAIL_UNAVAILABLE)로 끝납니다.
#   smtp: SMTP 서버로 보냅니다(배포). SMTP_HOST · SMTP_PORT · SMTP_USER · SMTP_PASS · MAIL_FROM이 모두 필요하고, 빠지거나 틀리면 서버가 시작되지 않습니다.
#   log: 메일 대신 서버 로그에 인증번호를 남깁니다(로컬 개발 전용. 배포에서는 절대 쓰지 않습니다).
# 항상 암호화해서 연결합니다. 465는 처음부터 암호화하고, 그 밖의 포트(587 등)는 STARTTLS를 올리지 못하면 연결을 포기합니다.
# SMTP_PASS는 계정 비밀번호가 아니라 서비스가 발급한 앱 비밀번호를 씁니다(Gmail은 2단계 인증을 켠 뒤 발급). 시크릿이니 커밋하지 않습니다.
# MAIL_FROM은 보내는 주소 하나입니다(이름 없이). 대부분의 SMTP 서비스는 로그인한 계정(SMTP_USER)과 같은 주소만 보내는 사람으로 인정하니 같게 둡니다.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=replace-with-app-password
MAIL_FROM=noreply@example.com
# 로컬: MAIL_TRANSPORT=log

# 스터디룸 라이브. API 서버에만 설정하며 비밀키는 앱에 넣지 않습니다.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 파일 저장소(Azure Blob) — 앱이 파일을 바로 올릴 주소(SAS)를 만드는 데 씁니다. AI 서버와 같은 스토리지 계정입니다.
# 스토리지 계정 > 액세스 키 > key1의 "연결 문자열". 시크릿이니 커밋하지 않습니다.
# 비워 두면 서버는 뜨고 POST /uploads/sas만 503을 돌려줍니다. 컨테이너를 바꾸려면 AZURE_STORAGE_UPLOAD_CONTAINER(기본 raw).
AZURE_STORAGE_CONNECTION_STRING=
