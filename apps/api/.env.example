# 로컬 개발용 예시. 복사해서 .env로 쓰고, .env는 커밋하지 않습니다.
MONGODB_URI=mongodb://localhost:27017/notelink
PORT=3000

# 인증(JWT) — 로컬 개발 전용 값입니다. 운영에서는 반드시 다른 강한 값으로 바꿉니다.
# 시크릿은 서로 다른 32자 이상, 수명은 숫자 + 단위(s m h d w y)로 씁니다. 예: 15m, 14d
JWT_ACCESS_SECRET=local-dev-access-secret-please-change-in-prod
JWT_REFRESH_SECRET=local-dev-refresh-secret-please-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
