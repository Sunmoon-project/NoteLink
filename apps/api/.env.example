# 로컬 개발용 예시. 복사해서 .env로 쓰고, .env는 커밋하지 않습니다.
MONGODB_URI=mongodb://localhost:27017/notelink
PORT=3000

# 인증(JWT) — 로컬 개발 전용 값입니다. 운영에서는 반드시 다른 강한 값으로 바꿉니다.
# 시크릿은 서로 다른 32자 이상, 수명은 숫자 + 단위(s m h d w y, 최소 1s)로 씁니다. 예: 15m, 14d
# 시크릿 만들기(access · refresh 각각 따로 한 번씩 실행): openssl rand -base64 48
JWT_ACCESS_SECRET=local-dev-access-secret-please-change-in-prod
JWT_REFRESH_SECRET=local-dev-refresh-secret-please-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# 구글 로그인 — 구글 콘솔 > 웹 애플리케이션 OAuth 클라이언트에서 발급한 값으로 바꿉니다. 시크릿은 커밋하지 않습니다.
# 아직 키가 없으면 아래 예시 값 그대로 두어도 서버는 시작되지만 구글 로그인은 동작하지 않습니다.
# GOOGLE_REDIRECT_URI는 구글 콘솔의 "승인된 리디렉션 URI"와 글자까지 같아야 합니다(운영은 https 주소).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/google/callback
