# 배포(Azure App Service) 기준 예시. 실제 값은 App Service의 환경 변수(앱 설정)에 넣고,
# 로컬에서는 복사해서 .env로 쓰되 각 줄 아래 "로컬:" 값으로 바꿉니다. .env는 커밋하지 않습니다.
# 웹 서버(uvicorn)와 작업 처리기(python -m app.worker) 모두 같은 값을 씁니다.
APP_ENV=production
# 로컬: APP_ENV=development

# 퀴즈 · 노트 · 녹음 LLM. claude(기본) · school(학교 LLM)
LLM_PROVIDER=claude
# Claude API 키(팀 워크스페이스). 키는 따로 받은 값을 넣고 이 파일에는 적지 않습니다.
ANTHROPIC_API_KEY=
# 모델을 바꿀 때만 넣습니다. 비우면 문제 만들기 · 노트 · 녹음은 claude-sonnet-5-5, 검사는 claude-haiku-5-5
# QUIZ_GEN_MODEL=
# QUIZ_CHECK_MODEL=
# 호출 간격(초). 비우면 Claude 0.2 · 학교 LLM 2.2
# LLM_CALL_GAP_SEC=
# Claude에 쓸 전체 기간 비용 상한(달러). 작업마다 쓴 비용(ai_jobs.llmUsd) 합계가 닿으면 학교 LLM으로 넘김.
# 0이면 제한 없음. Claude Console의 워크스페이스 한도도 같은 값으로 둠
CLAUDE_BUDGET_USD=70
# DB에 적지 못한 Claude 비용을 남기는 파일(처리기 작업 폴더 기준). 다시 시작하면 읽어 다시 적음
# LLM_COST_SPOOL=llm-cost-spool.json

# 학교 LLM (OpenAI 호환). LLM_PROVIDER=school일 때, 그리고 Claude 비용 한도에 닿은 뒤 넘길 때 씀
# (비우면 한도에 닿은 뒤 작업이 설정 오류로 끝남). 주소 · 키는 따로 받은 값(키는 공유하지 않음).
SCHOOL_LLM_BASE_URL=
SCHOOL_LLM_API_KEY=

# ai_jobs 작업 처리기. MongoDB Atlas 접속 문자열(Atlas > Connect > Drivers). API 서버와 같은 클러스터 · DB를 씁니다.
MONGODB_URI=mongodb+srv://<사용자>:<비밀번호>@<클러스터>.mongodb.net/?retryWrites=true&w=majority
# 로컬: MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=notelink

# 노트 OCR(Azure Document Intelligence) · 파일(Azure Blob Storage).
# Blob은 Azure 포털 > 저장소 계정 > 액세스 키의 연결 문자열을 넣습니다.
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# 노트 조각 임베딩(Voyage). Atlas에서 받은 키는 주소가 다를 수 있습니다.
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_API_KEY=

# 녹음 음성 인식(Azure AI Speech). 리소스 주소와 키를 넣습니다.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=

# 노트 후처리(오타 고치기 · 개념 태그). 과목 용어 사전이 준비되면 켬
NOTE_REFINE_ENABLED=false
