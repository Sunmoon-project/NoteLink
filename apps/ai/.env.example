# 배포(Azure App Service) 기준 예시. 실제 값은 App Service의 환경 변수(앱 설정)에 넣고,
# 로컬에서는 복사해서 .env로 쓰되 각 줄 아래 "로컬:" 값으로 바꿉니다. .env는 커밋하지 않습니다.
# 웹 서버(uvicorn)와 작업 처리기(python -m app.worker) 모두 같은 값을 씁니다.
APP_ENV=production
# 로컬: APP_ENV=development

# 학교 LLM (OpenAI 호환). 주소 · 키는 따로 받은 값을 넣습니다(키는 공유하지 않음).
SCHOOL_LLM_BASE_URL=
SCHOOL_LLM_API_KEY=

# ai_jobs 작업 처리기. MongoDB Atlas 접속 문자열(Atlas > Connect > Drivers). API 서버와 같은 클러스터 · DB를 씁니다.
MONGODB_URI=mongodb+srv://<사용자>:<비밀번호>@<클러스터>.mongodb.net/?retryWrites=true&w=majority
# 로컬: MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=notelink

# 노트 OCR(Azure Document Intelligence) · 파일(Azure Blob Storage).
# Blob은 Azure 포털 > 저장소 계정 > 액세스 키의 연결 문자열을 넣습니다.
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# 노트 조각 임베딩(Voyage). Atlas에서 받은 키는 주소가 다를 수 있습니다.
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_API_KEY=

# 녹음 음성 인식(Azure AI Speech). 리소스 주소와 키를 넣습니다.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=

# 노트 후처리(오타 고치기 · 개념 태그). 과목 용어 사전이 준비되면 켬
NOTE_REFINE_ENABLED=false
