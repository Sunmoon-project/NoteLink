{
  "name": "notelink",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/mobile",
    "apps/ai"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "turbo run dev --filter=@notelink/api",
    "dev:mobile": "turbo run start --filter=@notelink/mobile",
    "dev:ai": "turbo run dev --filter=@notelink/ai"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "allowScripts": {
    "@swc/core@1.16.13": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "multer": "2.5.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-asset": "57.0.20",
    "expo-constants": "57.0.22"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
